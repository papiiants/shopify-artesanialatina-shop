{% schema %}
{
  "name": "Custom Top Bar",
  "settings": [
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "Hacemos envíos rápidos y seguros a todo el mundo. Consulta condiciones"
    },
    {
      "type": "url",
      "id": "shipping_link",
      "label": "Shipping Link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "aquí"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Custom Top Bar"
    }
  ]
}
{% endschema %}

{% style %}
    .custom-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding-block: 5px;
        font-size: 12px;
    }

    .custom-top-bar__link {
        text-decoration: underline;
    }

    .custom-top-bar__location-icon {
        display: inline-block;
        width: 11px;
        height: 15px;
        margin-right: 2px;
    }
{% endstyle %}

<div class="custom-top-bar color-{{ section.settings.color_scheme }}">
    <div class="custom-top-bar__location">
        <span class="custom-top-bar__location-icon">
            <svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="map-marker-alt" class="svg-inline--fa fa-map-marker-alt fa-w-12" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path fill="currentColor" d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"></path></svg>
        </span>
        España
    </div>

    <div class="custom-top-bar__text">
        {{ section.settings.shipping_text }} <a class="custom-top-bar__link" href="{{ section.settings.shipping_link }} >{{ section.settings.link_text }}</a>
    </div>

    <div class="custom-top-bar__services">
        Profesional |
        {% include 'gtranslate' %}
    </div>
</div>