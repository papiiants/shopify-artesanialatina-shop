{% doc %}
  @prompt
    Сгенерируй мне блок в котором будет выводится слудующий список платежных методов:
    Visa
    MasterCard
    Bizum
    Paypal
    Discover
    Klarna
    Paygold
    Scalapay
    Для каждого метода что бы была возможность добавить подготовленную иконку.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-methods-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-payment-methods-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.gap }}px;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
  }

  .ai-payment-method-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_width }}px;
    height: {{ block.settings.icon_height }}px;
    background-color: {{ block.settings.icon_background }};
    border: {{ block.settings.icon_border_width }}px solid {{ block.settings.icon_border_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
    transition: transform 0.2s ease;
  }

  .ai-payment-method-item-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-payment-method-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-payment-method-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-payment-method-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-payment-methods-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-payment-method-item-{{ ai_gen_id }} {
      width: {{ block.settings.icon_width | times: 0.8 }}px;
      height: {{ block.settings.icon_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<payment-methods-{{ ai_gen_id }}
  class="ai-payment-methods-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-payment-methods-container-{{ ai_gen_id }}">
    {% if block.settings.visa_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.visa_icon %}
          <img
            src="{{ block.settings.visa_icon | image_url: width: 200 }}"
            alt="Visa"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.mastercard_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.mastercard_icon %}
          <img
            src="{{ block.settings.mastercard_icon | image_url: width: 200 }}"
            alt="MasterCard"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.bizum_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.bizum_icon %}
          <img
            src="{{ block.settings.bizum_icon | image_url: width: 200 }}"
            alt="Bizum"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.paypal_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.paypal_icon %}
          <img
            src="{{ block.settings.paypal_icon | image_url: width: 200 }}"
            alt="PayPal"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.discover_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.discover_icon %}
          <img
            src="{{ block.settings.discover_icon | image_url: width: 200 }}"
            alt="Discover"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.klarna_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.klarna_icon %}
          <img
            src="{{ block.settings.klarna_icon | image_url: width: 200 }}"
            alt="Klarna"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.paygold_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.paygold_icon %}
          <img
            src="{{ block.settings.paygold_icon | image_url: width: 200 }}"
            alt="Paygold"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.scalapay_enabled %}
      <div class="ai-payment-method-item-{{ ai_gen_id }}">
        {% if block.settings.scalapay_icon %}
          <img
            src="{{ block.settings.scalapay_icon | image_url: width: 200 }}"
            alt="Scalapay"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</payment-methods-{{ ai_gen_id }}>

<script>
  (function() {
    class PaymentMethods{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('payment-methods-{{ ai_gen_id }}', PaymentMethods{{ ai_gen_id }});
  })();
</script>

