{% doc %}
  @prompt
    Сгенерируй мне блок в котором будет выводится слудующий список платежных методов:
    Visa
    MasterCard
    Bizum
    Paypal
    Discover
    Klarna
    Paygold
    Scalapay
    Для каждого метода что бы была возможность добавить подготовленную иконку., переделай это будет иметь вид:
    элемент списка ul расположение column, gap: 5px, содержимое элемента горизонтальное gap: 5px;:
    иконка платежной системы + название платежной системы предоставленное выше.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-methods-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-payment-methods-list-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ai-payment-method-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .ai-payment-method-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border: {{ block.settings.icon_border_width }}px solid {{ block.settings.icon_border_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
  }

  .ai-payment-method-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-payment-method-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-payment-method-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-payment-method-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
  }

  @media screen and (max-width: 749px) {
    .ai-payment-methods-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<payment-methods-{{ ai_gen_id }}
  class="ai-payment-methods-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <ul class="ai-payment-methods-list-{{ ai_gen_id }}">
    {% if block.settings.visa_enabled %}
      <li class="ai-payment-method-item-{{ ai_gen_id }}">
        <div class="ai-payment-method-icon-{{ ai_gen_id }}">
          {% if block.settings.visa_icon %}
            <img
              src="{{ block.settings.visa_icon | image_url: width: 100 }}"
              alt="Visa"
              loading="lazy"
              width="100"
              height="100"
            >
          {% else %}
            <div class="ai-payment-method-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <span class="ai-payment-method-name-{{ ai_gen_id }}">Visa</span>
      </li>
    {% endif %}

    {% if block.settings.mastercard_enabled %}
      <li class="ai-payment-method-item-{{ ai_gen_id }}">
        <div class="ai-payment-method-icon-{{ ai_gen_id }}">
