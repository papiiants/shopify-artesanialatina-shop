          {% endif %}
        </div>
        <span class="ai-payment-method-name-{{ ai_gen_id }}">PayPal</span>
      </li>
    {% endif %}

    {% if block.settings.discover_enabled %}
      <li class="ai-payment-method-item-{{ ai_gen_id }}">
        <div class="ai-payment-method-icon-{{ ai_gen_id }}">
          {% if block.settings.discover_icon %}
