              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <span class="ai-payment-method-name-{{ ai_gen_id }}">Discover</span>
      </li>
    {% endif %}

    {% if block.settings.klarna_enabled %}
      <li class="ai-payment-method-item-{{ ai_gen_id }}">
        <div class="ai-payment-method-icon-{{ ai_gen_id }}">
          {% if block.settings.klarna_icon %}
            <img
              src="{{ block.settings.klarna_icon | image_url: width: 100 }}"
              alt="Klarna"
